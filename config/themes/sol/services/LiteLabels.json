{
  "background": null,
  "rules": [
    { "note": "road names",           "match": { "type": "symbol", "source_layer": "^Roads" },                          "paint": { "text-color": "@label", "text-halo-color": "@halo" } },
    { "note": "minor road names",     "match": { "type": "symbol", "source_layer": "^Roads", "id": "Minor Rds" },       "paint": { "text-color": "@label_minor" } },
    { "note": "Interstate shield route numbers: matches the near-white number UGRC's own Vector_Overlay style pairs with that same shield graphic (see theme.json's borrowed sol sprite). No halo, same as Vector_Overlay's own - the number sits directly on the colorful shield, not bare like the other road name text this service's generic 'road names' rule above targets.",
      "match": { "type": "symbol", "source_layer": "^Roads", "id": "/label/Interstates" }, "paint": { "text-color": "@shield_text_interstate", "text-halo-color": null } },
    { "note": "US/State highway shield route numbers: matches the dark number UGRC's own Vector_Overlay style pairs with those shield graphics. No halo, same reasoning as Interstates above.",
      "match": { "type": "symbol", "source_layer": "^Roads", "id": "/label/(US Highways|State Highways)" }, "paint": { "text-color": "@shield_text_highway", "text-halo-color": null } },

    { "note": "cities/towns",         "match": { "type": "symbol", "source_layer": "^CitiesTownsLocations" },           "paint": { "text-color": "@label_major", "text-halo-color": "@halo" } },
    { "note": "small places",         "match": { "type": "symbol", "source_layer": "^CitiesTownsLocations", "id": "- minor$" }, "paint": { "text-color": "@label" } },
    { "note": "big places",           "match": { "type": "symbol", "source_layer": "^CitiesTownsLocations", "id": "- major$" }, "paint": { "text-color": "@label_city_major" } },
    { "note": "municipality names",   "match": { "type": "symbol", "source_layer": "^muni_pts$" },                      "paint": { "text-color": "@label_city_major", "text-halo-color": "@halo" } },

    { "note": "counties + anno",      "match": { "type": "symbol", "source_layer": "^(Counties|AnnoPoints)$" },         "paint": { "text-color": "@label_region", "text-halo-color": "@halo" } },
    { "note": "addresses",            "match": { "type": "symbol", "source_layer": "^AddressPoints$" },                 "paint": { "text-color": "@label_minor", "text-halo-color": "@halo", "text-halo-width": 1 } },

    { "note": "water labels",         "match": { "type": "symbol", "source_layer": "(?i)(lake|river|stream|water|reservoir|bay)" }, "paint": { "text-color": "@label_water", "text-halo-color": "@halo_water" } },
    { "note": "park/forest labels",   "match": { "type": "symbol", "source_layer": "(?i)(park|monument|forest|wilderness|recreation)" }, "paint": { "text-color": "@label_park", "text-halo-color": "@halo" } }
  ]
}
