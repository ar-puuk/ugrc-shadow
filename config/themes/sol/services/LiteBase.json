{
  "background": null,
  "rules": [
    { "note": "neighbouring states",  "match": { "source_layer": "^WesternStates$" },  "paint": { "fill-color": "@earth", "fill-outline-color": "@boundary_faint" } },
    { "note": "Utah base",            "match": { "source_layer": "^Utah$" },           "paint": { "fill-color": "@earth" } },

    { "note": "local parks/golf/cemeteries", "match": { "source_layer": "^(Cemeteries_Poly|GolfCourses|ParksLocal)$" },
      "paint": { "fill-color": { "color": "@park", "alpha": 0.9 }, "fill-outline-color": "@park_outline" } },
    { "note": "nat/state park bands", "match": { "source_layer": "^UtahParksAndMonuments$", "type": "line" }, "paint": { "line-color": "@park_band" } },
    { "note": "nat/state park edge",  "match": { "source_layer": "^UtahParksAndMonuments$", "type": "line", "id": "/1$" }, "paint": { "line-color": "@park_outline" } },
    { "note": "ski areas",            "match": { "source_layer": "^SkiAreaBoundaries$" }, "paint": { "fill-outline-color": "@boundary_faint" } },
    { "note": "airport boundary",     "match": { "source_layer": "^Airports$", "type": "line" }, "paint": { "line-color": { "color": "@airport_boundary", "alpha": 0.75 } } },

    { "note": "contours",             "match": { "source_layer": "^Contours" }, "paint": { "line-color": "@contour", "line-opacity": 0.3 } },
    { "note": "index contours",       "match": { "source_layer": "^Contours", "id": "/(500|1000)(_\\d+)?$" }, "paint": { "line-color": "@contour_index" } },

    { "note": "urban area tint",      "match": { "source_layer": "^Municipalities_Carto:2$", "type": "fill" }, "paint": { "fill-color": "@urban_tint" } },
    { "note": "urban class halos (keep hue)", "match": { "source_layer": "^Municipalities_Carto:2$", "type": "line" }, "paint": { "line-color": { "tint": { "l": 0.82, "s_mult": 0.35 } } } },
    { "note": "municipal boundary",   "match": { "source_layer": "^Municipalities_Carto:1$" }, "paint": { "line-color": "@boundary_muni" } },

    { "note": "any water (generic)",  "match": { "source_layer": "(?i)(water|lake|river|reservoir|canal)", "type": "fill" }, "paint": { "fill-color": "@water", "fill-outline-color": "@water_outline" } },
    { "note": "rivers/lakes polys",   "match": { "source_layer": "^(UtahMajorRiversPoly|LakesNHDHighRes.*|GSLWaterLevel.*)$" }, "paint": { "fill-color": "@water", "fill-outline-color": "@water_outline" } },
    { "note": "GSL evaporation ponds","match": { "source_layer": "^LakesNHDHighRes", "id": "Great Salt Lake" }, "paint": { "fill-color": "@water_shallow" } },
    { "note": "streams",              "match": { "source_layer": "^StreamsNHD" }, "paint": { "line-color": "@water_line" } },

    { "note": "county lines",         "match": { "source_layer": "^Counties$", "type": "line" }, "paint": { "line-color": "@boundary" } },
    { "note": "county solid bands",   "match": { "source_layer": "^Counties$", "type": "line", "paint": { "line-color": "^#[A-F][0-9A-F]" } }, "paint": { "line-color": "@boundary_halo" } },

    { "note": "buildings (if present)", "match": { "source_layer": "(?i)build", "type": "fill" }, "paint": { "fill-color": { "color": "@buildings", "alpha": 0.5 }, "fill-outline-color": "@road_casing" } },
    { "note": "railroads",            "match": { "source_layer": "^Railroads$" }, "paint": { "line-color": "@rail", "icon-color": "@rail" } },
    { "note": "trails outer",         "match": { "source_layer": "^TrailsAndPathways$", "id": "/1$" }, "paint": { "line-color": "@trail_outer" } },
    { "note": "trails inner",         "match": { "source_layer": "^TrailsAndPathways$", "id": "/0$" }, "paint": { "line-color": "@trail_inner" } },

    { "note": "interstates (fill): the one class kept in Voyager's bolder motorway tone - everything else below reads as one paler 'major road' family",
      "match": { "source_layer": "^Roads", "type": "line", "id": "/Interstates" },                                        "paint": { "line-color": "@road_highway" } },
    { "note": "US/State highways (fill): grouped with fed-aid/major local paved below (Voyager's secondary tone) rather than Interstates - Voyager's own primary and motorway tones are too close to read as distinct anyway",
      "match": { "source_layer": "^Roads", "type": "line", "id": "/(US Highways|State Highways)" },                       "paint": { "line-color": "@road_medium" } },
    { "note": "ramps/collectors",     "match": { "source_layer": "^Roads", "type": "line", "id": "/Ramps and Collectors" },                              "paint": { "line-color": "@road_medium" } },
    { "note": "fed-aid + major local (fill)", "match": { "source_layer": "^Roads", "type": "line", "id": "/(Other Federal Aid Roads|Major Local Roads Paved)" }, "paint": { "line-color": "@road_medium" } },
    { "note": "major local unpaved (fill)", "match": { "source_layer": "^Roads", "type": "line", "id": "/Major Local Roads Not Paved" },                 "paint": { "line-color": "@road_unpaved" } },
    { "note": "local roads (fill)",   "match": { "source_layer": "^Roads", "type": "line", "id": "/Local Roads" },                                       "paint": { "line-color": "@road_minor" } },
    { "note": "road casings (/1): generic fallback for any class below not given its own casing", "match": { "source_layer": "^Roads", "type": "line", "id": "/1$" }, "paint": { "line-color": "@road_casing" } },

    { "note": "interstate casing (/1): matches Voyager's per-class case/fill pairing instead of the shared generic casing above",
      "match": { "source_layer": "^Roads", "type": "line", "id": "/Interstates(_\\d+)?/1$" }, "paint": { "line-color": "@road_highway_casing" } },
    { "note": "US/State highway casing (/1): same secondary tone as fed-aid/major local paved below",
      "match": { "source_layer": "^Roads", "type": "line", "id": "/(US Highways|State Highways)(_\\d+)?/1$" }, "paint": { "line-color": "@road_medium_casing" } },
    { "note": "fed-aid + major local paved casing (/1)",
      "match": { "source_layer": "^Roads", "type": "line", "id": "/(Other Federal Aid Roads|Major Local Roads Paved)(_\\d+)?/1$" }, "paint": { "line-color": "@road_medium_casing" } },
    { "note": "major local unpaved casing (/1)",
      "match": { "source_layer": "^Roads", "type": "line", "id": "/Major Local Roads Not Paved(_\\d+)?/1$" }, "paint": { "line-color": "@road_unpaved_casing" } },
    { "note": "local road casing (/1)",
      "match": { "source_layer": "^Roads", "type": "line", "id": "/Local Roads(_\\d+)?/1$" }, "paint": { "line-color": "@road_minor_casing" } },

    { "note": "transit casing (/2): borrowed from Vector_Overlay's neutral rail-track gray, replacing the tan tint that got lost behind the road palette", "match": { "source_layer": "^(CommuterRailRoutes_UTA|UTA_Trax_SingleLine)$", "id": "/2$" }, "paint": { "line-color": "@transit_casing" } },
    { "note": "transit fill (/1): borrowed from Vector_Overlay (white, sits inside the gray casing)", "match": { "source_layer": "^(CommuterRailRoutes_UTA|UTA_Trax_SingleLine)$", "id": "/1$" }, "paint": { "line-color": "@transit_fill" } },

    { "note": "commuter rail (FrontRunner) route color (/0): borrowed verbatim from Vector_Overlay",
      "match": { "source_layer": "^CommuterRailRoutes_UTA$", "id": "/0$" }, "paint": { "line-color": { "color": "@transit_commuter", "alpha": 0.85 } } },
    { "note": "TRAX Blue Line route color (/0): borrowed verbatim from Vector_Overlay",
      "match": { "source_layer": "^UTA_Trax_SingleLine$", "id": "/B(2|3)?(_\\d+)?/0$" }, "paint": { "line-color": { "color": "@transit_blue", "alpha": 0.85 } } },
    { "note": "TRAX Green Line route color (/0): borrowed verbatim from Vector_Overlay",
      "match": { "source_layer": "^UTA_Trax_SingleLine$", "id": "/G(2|3)?(_\\d+)?/0$" }, "paint": { "line-color": { "color": "@transit_green", "alpha": 0.9 } } },
    { "note": "TRAX Red Line route color (/0): borrowed verbatim from Vector_Overlay",
      "match": { "source_layer": "^UTA_Trax_SingleLine$", "id": "/R(2|3)?(_\\d+)?/0$" }, "paint": { "line-color": { "color": "@transit_red", "alpha": 0.8 } } },
    { "note": "TRAX S-Line route color (/0): borrowed verbatim from Vector_Overlay",
      "match": { "source_layer": "^UTA_Trax_SingleLine$", "id": "/S(_\\d+)?/0$" }, "paint": { "line-color": { "color": "@transit_teal", "alpha": 0.85 } } },

    { "note": "transit other: borrowed from Vector_Overlay's generic gray for anything unclassified", "match": { "source_layer": "^UTA_Trax_SingleLine$", "id": "<all other values>" }, "paint": { "line-color": "@transit_other" } }
  ]
}
